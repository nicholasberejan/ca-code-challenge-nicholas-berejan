# Copy to .env and adjust if needed. Defaults work for the challenge out of the box.

MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wp
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
WORDPRESS_TABLE_PREFIX=wp_

# Seeded admin credentials (informational — re-run scripts/seed.sh to recreate)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE="Brand Reviews Challenge"

# --- Django replacement site (web + auth services) ---------------------------
# Every value below is for LOCAL DEVELOPMENT ONLY.

# Main web service and its PostgreSQL database (main-db)
WEB_DJANGO_SECRET_KEY=dev-only-5c3426da5dfe77b8f1c3d63eb3ed54aa3343cd441cb2fe7eeca389a68358e2e6
MAIN_DB_NAME=main
MAIN_DB_USER=main
MAIN_DB_PASSWORD=main-dev-password

# Auth service and its PostgreSQL database (auth-db)
AUTH_DJANGO_SECRET_KEY=dev-only-6c0270995f2d2dcc9da745b282838f6545d1185af00b22f2cba6a9c378d66cf0
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth-dev-password

# Token contract
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=brand-reviews-web

# RS256 key pair, base64-encoded PEM on one line.
# DEV ONLY — production keys come from a secret store.
# docker-compose.yml passes JWT_PRIVATE_KEY only to the auth service;
# the web service receives only JWT_PUBLIC_KEY.
JWT_PRIVATE_
JWT_PUBLIC_

# WordPress source database, read by the import commands (later phases)
WP_DB_HOST=db
WP_DB_NAME=wp
WP_DB_USER=wp
WP_DB_PASSWORD=wp
